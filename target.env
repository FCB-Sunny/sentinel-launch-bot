# The model the bot submits. Change these lines (and nothing else) to switch the target.
# The expected sha256 is read from the target repo itself (TARGET_SHA_FILE), so it never sits in this public repo:
# publishing a model's digest before it is committed would let anyone commit that digest first.
TARGET_NAME=v10g
TARGET_REPO=https://github.com/FCB-Sunny/sentinel-v10g.git
TARGET_DIR=$HOME/sentinel-v10g
TARGET_ZIP=Submission/submission.zip
TARGET_SHA_FILE=Submission/sha256.txt
